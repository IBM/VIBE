# API Agent Service Configuration
PORT=5003
HOST=localhost
BACKEND_URL=http://localhost:5000
BACKEND_TIMEOUT=30000

# External API request timeout in ms. Increase this for long-running agent responses.
DEFAULT_TIMEOUT=60000
# Example for a 5 minute timeout:
# DEFAULT_TIMEOUT=300000
HEALTH_CHECK_INTERVAL=60000

# Job poller configuration
POLLER_BASE_INTERVAL_MS=5000
POLLER_MAX_INTERVAL_MS=60000
POLLER_BACKOFF_MULTIPLIER=1.5
POLLER_MAX_CONCURRENT_JOBS=3